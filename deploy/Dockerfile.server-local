# Local development server — includes Go toolchain for on-demand client builds.
# Production uses Dockerfile.server (slim) + Dockerfile.builder (sidecar) instead.
# Using bookworm (Debian) because golang:1.25-alpine has corrupt layers on Docker Hub.

# --- Stage 1: Build client SPA ---
FROM node:22-slim AS spa-builder
WORKDIR /spa
COPY web/client-ui/package.json web/client-ui/package-lock.json ./
RUN npm ci
COPY web/client-ui/ ./
RUN npm run build

# --- Stage 2: Build Go server + client binaries ---
FROM golang:1.25-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates tzdata && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Cache Go modules
COPY go.mod go.sum ./
RUN go mod download

# Copy full source (needed for both server build and client cross-compilation)
COPY . .

# Copy built SPA into Go embed directory
COPY --from=spa-builder /spa/build/ ./internal/client/webui/static/

# Build server binary
RUN CGO_ENABLED=0 go build \
    -ldflags="-s -w" \
    -trimpath \
    -o /usr/local/bin/trasker-server \
    ./cmd/trasker-server

# The server runs from /src so the builder can find go.mod and cross-compile
# cmd/trasker-client on demand.
EXPOSE 8080

ENTRYPOINT ["trasker-server"]
